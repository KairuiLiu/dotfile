font-family = "Fira Code"
font-family-bold = "Fira Code"
font-family-italic = "Fira Code"
font-family-bold-italic = "Fira Code"
font-codepoint-map = U+E5FA-U+E62B=Iosevka Nerd Font
font-codepoint-map = U+E700-U+E7C5=Iosevka Nerd Font
font-codepoint-map = U+F000-U+F2E0=Iosevka Nerd Font
font-codepoint-map = U+E200-U+E2A9=Iosevka Nerd Font
font-codepoint-map = U+F500-U+FD46=Iosevka Nerd Font
font-codepoint-map = U+E300-U+E3EB=Iosevka Nerd Font
font-codepoint-map = U+F400-U+F4A8,U+2665,U+26A1,U+F27C=Iosevka Nerd Font
font-codepoint-map = U+E0A3,U+E0B4-U+E0C8,U+E0CC-U+E0D2,U+E0D4=Iosevka Nerd Font
font-codepoint-map = U+23FB-U+23FE,U+2b58=Iosevka Nerd Font
font-codepoint-map = U+F300-U+F313=Iosevka Nerd Font
font-codepoint-map = U+E000-U+E00D=Iosevka Nerd Font
font-codepoint-map = U+4E00-U+9FFF,U+3400-U+4DBF=LXGW WenKai GB Screen
font-size = 14
font-feature = calt
font-feature = liga
font-feature = dlig
font-shaping-break = false

cursor-color = #eee9fc
cursor-text = #eee9fc
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

scrollback-limit = 2000
bell-features = "no-audio"
confirm-close-surface = false
macos-titlebar-proxy-icon="hidden"
title=" "

background = #161616
foreground = #eee9fc
background-opacity = 0.7
background-blur = true

