#######################################
## Get dotfile from github           ##
#######################################

sudo pacman -Syyu
sudo pacman -S vim wget git
ssh-keygen -t ed25519 -C "tclkr@live.com"
cat .ssh/id_ed25519.pub
# add ssh key to github
git clone git@github.com:KairuiLiu/dotfile.git .dotfile

#######################################
## Pacman & aur config               ##
#######################################

# get mirrorlist from https://archlinux.org/mirrorlist/
sudo vim /etc/pacman.d/mirrorlist
# sudo vim /etc/pacman.conf
## [archlinuxcn]
## Include = /etc/pacman.d/archlinuxcn-mirrorlist
sudo cp "$HOME/.dotfile/aur/archlinuxcn-mirrorlist" /etc/pacman.d/
sudo pacman -Syyu
sudo pacman -S archlinuxcn-keyring
sudo pacman -S clash-verge yay zsh

#######################################
## X.org config                      ##
#######################################

ln -s "$HOME/.dotfile/x.org/Xresources" "$HOME/.Xresources"
ln -s "$HOME/.dotfile/x.org/Xmodmap" "$HOME/.Xmodmap"
ln -s "$HOME/.dotfile/x.org/xinitrc" "$HOME/.xinitrc"
ln -s "$HOME/.dotfile/x.org/picom" "$HOME/.config/picom"

#######################################
## shell                             ##
#######################################

ln -s "$HOME/.dotfile/shell/zshrc" "$HOME/.zshrc"
ln -s "$HOME/.dotfile/shell/bashrc" "$HOME/.bashrc"
ln -s "$HOME/.dotfile/shell/xprofile" "$HOME/.xprofile"
ln -s "$HOME/.dotfile/shell/p10k.zsh" "$HOME/.p10k.zsh"
ln -s "$HOME/.dotfile/shell/pam_environment" "$HOME/.pam_environment"
ln -s "$HOME/.dotfile/shell/profile" "$HOME/.profile"
mkdir -p "$HOME/.dotfile/keep_local"

#######################################
## windows files                     ##
#######################################

# copy win-disk file
# install windows-fonts -> /usr/local/share/fonts/
fc-cache
sudo fc-cache

mkdir -p fileTrans/{c..f} fileTrans/liukairuiFtp
ln -s "$HOME/.dotfile/shell/mountWin.sh" "$HOME/fileTrans/mountWin.sh"
chmod 755 .dotfile/shell/mountWin.sh

#######################################
## install software                  ##
#######################################

# install aur/apps
# copy chrome proxy switch
systemctl enable tlp.service
systemctl enable NetworkManager-dispatcher.service
systemctl mask systemd-rfkill.service systemd-rfkill.socket
systemctl enable bluetooth.service

#######################################
## sway config                       ##
#######################################

ln -s "$HOME/.dotfile/sway/sway/sway_config" "$HOME/.config/sway/config"
ln -s "$HOME/.dotfile/sway/mako" "$HOME/.config/mako"
ln -s "$HOME/.dotfile/sway/waybar" "$HOME/.config/waybar"
# set wayland flag on chrome (chrome://flags)
ln -s "$HOME/.dotfile/sway/wofi" "$HOME/.config/wofi"
# MAYBE NOT NEEDED
# sudo cp "$HOME/.dotfile/sway/sway/sway-custom-env.desktop" /usr/share/wayland-sessions/

#######################################
## i3 config                         ##
#######################################

ln -s "$HOME/.dotfile/i3wm/i3_config" "$HOME/.config/i3/config"
ln -s "$HOME/.dotfile/i3wm/polybar" "$HOME/.config/polybar"
ln -s "$HOME/.dotfile/i3wm/dunstrc" "$HOME/.config/dunst/dunstrc"
ln -s "$HOME/.dotfile/i3wm/rofi" "$HOME/.config/rofi"
sudo chmod 4755 /usr/bin/light # enable set backlight in i3
# ln -s "$HOME/.dotfile/i3wm/touchegg.conf" "$HOME/.config/touchegg"

#######################################
## howdy config                      ##
#######################################

sudo vim /lib/security/howdy/config.ini
# set
# device_path = /dev/video2
# dark_threshold 100
# rev: 640 x 360
sudo howdy add
sudo howdy test
# set /etc/pam.d/sudo
# set /etc/pam.d/kde
# with auth sufficient pam_python.so /lib/security/howdy/pam.py

#######################################
## Vim                               ##
#######################################

curl -fLo "$HOME/.vim/autoload/plug.vim" --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
ln -s "$HOME/.dotfile/misc/vimrc" "$HOME/.vimrc"
cd .vim/plugged/xkb-switch
mkdir build && cd build
cmake ..
make
sudo ldconfig
sudo make install
cd
cd .vim/plugged/YouCompleteMe
./install.py

#######################################
# npm                                ##
#######################################

# tip: backup
# pnpm pnpm list -g --depth=0 --json | jq -r '.[0].dependencies | keys[]' > pnpm-global-packages.txt
cat "$HOME/.dotfile/misc/npm/pnpm-global-packages.txt" | xargs pnpm install -g

#######################################
## input method (fcitx + rime-ice)   ##
#######################################

# install fcitx5
ln -s "$HOME/.dotfile/fcitx5" "$HOME/.config/"
sudo cp "$HOME"/Public/fcitx5-**/* /usr/share/fcitx5/themes/ -r
# install rime-ice
cd "$HOME"
git clone https://github.com/rime/plum.git plum
cd "$HOME/plum"
rime_dir="$HOME/.local/share/fcitx5/rime/" && bash rime-install iDvel/rime-ice:others/recipes/full
cd "$HOME/.dotfile/misc"
stow -t "$HOME/.local/share/fcitx5/rime" rime
# config sync path
# vim "$HOME/.local/share/fcitx5/rime/installation.yaml"
# Tip: sync rime user data via gui, checkout config from other branch before sync dotfile

#######################################
## misc                              ##
#######################################

ln -s "$HOME/.dotfile/misc/mpdconf" "$HOME/.mpdconf"
ln -s "$HOME/.dotfile/misc/face" "$HOME/.face"
ln -s "$HOME/.dotfile/shell/eza.yml" "$HOME/.config/eza/theme.yml"
ln -s "$HOME/.dotfile/shell/ghostty" "$HOME/.config/ghostty/config"
ln -s "$HOME/.dotfile/misc/ranger" "$HOME/.config/ranger"
ln -s "$HOME/.dotfile/misc/clight.conf" "$HOME/.config/clight.conf"
# Set Kde Virtual Keyboard as fcitx5

# Typora Fix
vim "$HOME/.config/Typora/conf/conf.user.json"
# set autoHideMenuBar = true

# Sudo Pwd Feedback
edit /etc/sudoers
# set to tail Defaults pwfeedback

# create "$HOME/.xdmanrco"
# set like XDMAN_JAVA_HOME=/usr/lib/jvm/java-20-openjdk

# QQ Crash File Fix
sudo rm -rf "$HOME/.config/QQ/.crash_files/"*
sudo chattr +i "$HOME/.config/QQ/.crash_files/"

# vsftpd
sudo cp "$HOME/.dotfile/misc/vsftpd.conf" /etc/vsftpd.conf
ln -s /srv/ftp "$HOME/fileTrans/ftp"
mkdir /srv/ftp/anon ; chmod 777 /srv/ftp/anon

# Fix Chrome-[stable|beta|unstabel] GTK4 on wayland
cd /opt/google/chrome-beta/
sudo cp google-chrome-beta google-chrome-beta.bak
# edit google-chrome-beta to comment out the line
# Always use our versions of ffmpeg libs.
# This also makes RPMs find the compatibly-named library symlinks.
# if [[ -n "$LD_LIBRARY_PATH" ]]; then
#   LD_LIBRARY_PATH="$HERE:$HERE/lib:$LD_LIBRARY_PATH"
# else
#   LD_LIBRARY_PATH="$HERE:$HERE/lib"
# fi
# export LD_LIBRARY_PATH

# Fix close lid behavior
sudo vim /etc/systemd/logind.conf
# uncomment the line and set to ignore
## HandleLidSwitch=ignore
## HandleLidSwitchExternalPower=ignore
## HandleLidSwitchDocked=ignore

# Tips:
# config postman workspace
# check export
# check default export & setting
