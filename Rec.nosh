#######################################
## brew                              ##
#######################################

cd ~/.dotfile/brew
# install homebrew if not installed
brew bundle install
# check if everything is installed
brew bundle check
# tip: remake homebrew bundle file
# brew bundle dump --force --no-describe --no-npm --no-vscode --no-go --no-uv --file="$HOME/.dotfile/brew/Brewfile"

#######################################
## shell                             ##
#######################################

ln -s ~/.dotfile/shell/zshrc ~/.zshrc
ln -s ~/.dotfile/shell/bashrc ~/.bashrc
ln -s ~/.dotfile/shell/p10k.zsh ~/.p10k.zsh
mkdir -p ~/.config/eza
ln -s ~/.dotfile/shell/eza.yml ~/.config/eza/theme.yml

#######################################
## vim                               ##
#######################################

curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
ln -s ~/.dotfile/misc/vimrc ~/.vimrc
cd .vim/plugged/YouCompleteMe
./install.py

#######################################
## window manager                    ##
#######################################

# set up yabai (https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection)
# tip: use command+shift+g in finder to go to any folder
ln -s ~/.dotfile/yabai/skhdrc ~/.skhdrc
ln -s ~/.dotfile/yabai/yabairc ~/.yabairc

#######################################
# npm                                ##
#######################################
# tip: backup
# pnpm pnpm list -g --depth=0 --json | jq -r '.[0].dependencies | keys[]' > pnpm-global-packages.txt
cat ~/.dotfile/npm/pnpm-global-packages.txt | xargs pnpm install -g

#######################################
## application shortcuts             ##
#######################################

# karabiner
mkdir -p ~/.config/karabiner/assets
ln -s ~/.dotfile/misc/karabiner/karabiner.json ~/.config/karabiner/karabiner.json
ln -s ~/.dotfile/misc/karabiner/complex_modifications ~/.config/karabiner/assets/complex_modifications
# manual keybindings
# raycast => cmd+space for active
# raycast => opt+; for paste history
# snipaste => opt+shift+s
# system => built-in keyboard settings -> replace 🌐 key with control

#######################################
## misc                              ##
#######################################

# ghosty
mkdir -p ~/.config/ghostty/
ln -s ~/.dotfile/shell/ghostty ~/.config/ghostty/config
# ranger
ln -s ~/.dotfile/misc/ranger ~/.config/ranger
# sudo
# edit /etc/sudoers
# set to tail Defaults pwfeedback
# set up input method following: https://blog.zhheo.com/p/5e08f6be.html

#######################################
## input method (fcitx + rime-ice)   ##
#######################################
# install fcitx (https://github.com/fcitx-contrib/fcitx5-macos-installer/blob/master/README.zh-CN.md)
# install rime-ice
[ -d ~/plum ] || git clone https://github.com/rime/plum.git ~/plum
rime_stage=$(mktemp -d); rime_dir=$rime_stage bash ~/plum/rime-install iDvel/rime-ice:others/recipes/full
stow -d ~/.dotfile/misc -t ~/.local/share/fcitx5/rime rime
stow -d ~/.dotfile/misc -t ~/.config/fcitx5 fcitx5

rsync -a --ignore-existing "$rime_stage/cn_dicts/" ~/.dotfile/misc/rime/cn_dicts/
# modify sync config: ~/.local/share/fcitx5/rime/installation.yaml
# Tip: sync rime user data via gui, checkout config from other branch before sync dotfile
